# Basmatak Tatatoua backend — environment variables
# Copy to .env and fill in real values. All names are exact.
# Dev defaults are safe to leave unset (see comments).

# --- Server ---
# HTTP port (Render injects its own PORT in production)
PORT=
# production | development | test
NODE_ENV=

# --- Database ---
# MongoDB connection string. Unset -> local mongodb://127.0.0.1:27017/basmatak
# Production (Atlas M0): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basmatak?retryWrites=true&w=majority
MONGO_URI=

# --- CORS & base URL ---
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=
# Public base URL used in links/emails (e.g. https://your-service.onrender.com)
PUBLIC_BASE_URL=

# --- Logging ---
# log | error | warn | debug | verbose
LOG_LEVEL=

# --- OpenAPI (Swagger) ---
# true | false — serve the Swagger UI only when true
SWAGGER_ENABLED=

# --- Rate limiting (in-memory, single instance) ---
THROTTLE_TTL=
THROTTLE_LIMIT=

# --- Internal jobs endpoint ---
# Secret for POST /api/v1/internal/jobs/run (X-Jobs-Key header)
JOBS_KEY=

# --- JWT ---
# Secrets MUST be set in real environments (the API fails fast at boot otherwise)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime (e.g. 15m); refresh session expiry from JWT_REFRESH_TTL (e.g. 30d)
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# --- Email verification gate ---
# true | false (default false) — require verified email before publish/apply/submit
EMAIL_VERIFICATION_REQUIRED=

# --- Mail (Brevo SMTP; Gmail app password works too) ---
# Leave MAIL_HOST empty to fall back to LogMailService (mail rendered to the logger, dev only)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Media storage (Supabase Storage) ---
# local | supabase — local writes to ./storage (dev only)
STORAGE_PROVIDER=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- Admin account (created by seed script in Session 17) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Publish gate (enforced from Session 13) ---
# true | false — if true, gate lock blocks publish even before Session 13
PUBLISH_GATE_ENABLED=