# Basmatak Tatatoua backend — environment variables
# Copy to .env and fill in real values. All names are exact.
# Dev defaults are safe to leave unset (see comments).

# --- Server ---
# HTTP port (Render injects its own PORT in production)
PORT=5
# production | development | test
NODE_ENV=

# --- Database ---
# MongoDB connection string. Unset -> local mongodb://127.0.0.1:27017/basmatak
# Production (Atlas M0): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basmatak?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basmatak?retryWrites=true&w=majority
# (Never commit real credentials — keep them in your local .env only.)


# --- CORS & base URL ---
# Explicit allowlist, comma-separated, NO wildcard: bare "*" entries are
# dropped at boot (fail-closed). Entries are trimmed and trailing slashes
# stripped, so "http://localhost:3000/" and "http://localhost:3000" match.
# The effective list is logged at startup ("CORS allowlist: ...").
CORS_ORIGIN=http://localhost:3000
# Public base URL used in links/emails (e.g. https://your-service.onrender.com)
PUBLIC_BASE_URL=

# --- Logging ---
# log | error | warn | debug | verbose
LOG_LEVEL=

# --- OpenAPI (Swagger) ---
# true | false — serve the Swagger UI only when true
SWAGGER_ENABLED=

# --- Rate limiting (in-memory, single instance) ---
THROTTLE_TTL=
THROTTLE_LIMIT=

# --- Internal jobs endpoint ---
# Secret for POST /api/v1/internal/jobs/run (X-Jobs-Key header)
JOBS_KEY=

# --- JWT ---
# Secrets MUST be set in real environments (the API fails fast at boot otherwise)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime (e.g. 15m); refresh session expiry from JWT_REFRESH_TTL (e.g. 30d)
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# --- Email verification gate ---
# true | false (default false) — require verified email before publish/apply/submit
EMAIL_VERIFICATION_REQUIRED=

# --- Mail (Brevo SMTP; Gmail app password works too) ---
# Leave MAIL_HOST empty to fall back to LogMailService (mail rendered to the logger, dev only)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Media storage (Supabase Storage) ---
# local | supabase — local writes to ./storage (dev only)
STORAGE_PROVIDER=
# Optional override for STORAGE_PROVIDER=local (defaults to ./storage)
STORAGE_LOCAL_DIR=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- Admin account (created by seed script in Session 17) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Publish gate (enforced from Session 13) ---
# true | false — if true, gate lock blocks publish even before Session 13
PUBLISH_GATE_ENABLED=true

# --- AI assistant (Session 2) ---
# Kill switch. Only the literal value true enables the assistant; missing,
# false, or any other value keeps it disabled. Chat returns AI_AGENT_DISABLED.
AI_AGENT_ENABLED=
# Provider adapter (gemini is the default; the mock transport is used in S2).
AI_AGENT_PROVIDER=gemini
# Provider-specific model id.
AI_AGENT_MODEL=gemini-3.8-flash
# Knowledge root override. Unset -> <backend cwd>/ai-agent.
AI_AGENT_KNOWLEDGE_DIR=
# Budget caps (safe starting defaults; tune below the live free-tier quota).
# Session 2 parses these but does not enforce quota yet.
AI_AGENT_MAX_INPUT_TOKENS=3000
AI_AGENT_MAX_OUTPUT_TOKENS=400
AI_AGENT_MAX_HISTORY_MESSAGES=4
AI_AGENT_MAX_HISTORY_CHARS=2400
AI_AGENT_MAX_KNOWLEDGE_CHUNKS=4
AI_AGENT_MAX_KNOWLEDGE_CHARS=6000
AI_AGENT_MAX_TOOL_ROUNDS=1
AI_AGENT_MAX_TOOL_ROWS=5
AI_AGENT_MAX_TOOL_RESULT_CHARS=1200
AI_AGENT_IP_RPM=4
AI_AGENT_IP_RPD=15
AI_AGENT_GLOBAL_RPM=10
AI_AGENT_GLOBAL_RPD=80
AI_AGENT_MAX_CONCURRENT=2
AI_AGENT_DAILY_TOKEN_BUDGET=150000
# true | false — extractive snippets instead of an LLM when exhausted.
AI_AGENT_RETRIEVAL_FALLBACK=true
# true | false — optional one-shot provider fallback; off by default.
AI_AGENT_FALLBACK_ENABLED=false